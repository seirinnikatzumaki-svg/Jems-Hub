local NetworkRemote = game:GetService("ReplicatedStorage"):WaitForChild("NetworkEvent")

-- FUNCTIONALITY PARA SA AUTO FAST POWER
ToggleButton1.MouseButton1Click:Connect(function()
    getgenv().AutoFastPower = not getgenv().AutoFastPower
    if getgenv().AutoFastPower then
        ToggleButton1.Text = "Auto Fast Power: ON"
        ToggleButton1.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        task.spawn(function()
            while getgenv().AutoFastPower do
                pcall(function()
                    NetworkRemote:FireServer("AddTrampolinPower")
                end)
                task.wait() 
            end
        end)
    else
        ToggleButton1.Text = "Auto Fast Power: OFF"
        ToggleButton1.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    end
end)

