local EquipRemote = NetFolder["RF/EquipBestBrainrots"]
local UpgradeRemote = NetFolder["RF/PurchaseUpgrade"]
local RaiseLevelRemote = NetFolder["RF/UnlockBallDropLevel"]
local StackRemote = NetFolder["RF/QuickStack"]

task.spawn(function()
    while true do
        if getgenv().AutoFastDrop then
            local currentAmount = getgenv().SelectedDropAmount or 1
            for i = 1, 8 do
                pcall(function() DropEvent:FireServer(currentAmount) end)
            end
        end
        task.wait()
    end
end)

